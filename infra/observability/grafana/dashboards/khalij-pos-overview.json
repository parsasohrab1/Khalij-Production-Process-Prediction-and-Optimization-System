  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Service Up (NFR-PER-02)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "avg(up{job=~\"khalij-.*\"})",
          "legendFormat": "availability"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.99 },
              { "color": "green", "value": 0.9999 }
            ]
          }
        }
      },
      "id": 1
    },
    {
      "title": "Request Rate by Service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum by (service) (rate(khalij_http_requests_total[1m]))",
          "legendFormat": "{{ service }}"
        }
      ],
      "id": 2
    },
    {
      "title": "P95 Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (service, le) (rate(khalij_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{ service }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 2 }
            ]
          }
        }
      },
      "id": 3
    },
    {
      "title": "HTTP 5xx Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "sum by (service) (rate(khalij_http_requests_total{status=~\"5..\"}[5m]))",
          "legendFormat": "{{ service }}"
        }
      ],
      "id": 4
    },
    {
      "title": "In-Progress Requests",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "sum by (service) (khalij_http_requests_in_progress)",
          "legendFormat": "{{ service }}"
        }
      ],
      "id": 5
    }
  ],
