# ==============================================
# Khalij POS - Environment Configuration Template
# کپی این فایل را با نام .env در ریشه پروژه ذخیره کنید
# ==============================================

# ---------- General ----------
ENVIRONMENT=development
LOG_LEVEL=INFO
TIMEZONE=Asia/Tehran

# ---------- PostgreSQL (داده‌های تراکنشی) ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=khalij_pos
POSTGRES_USER=khalij_admin
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DSN=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ---------- InfluxDB (داده‌های سری زمانی) ----------
INFLUXDB_HOST=influxdb
INFLUXDB_PORT=8086
INFLUXDB_URL=http://${INFLUXDB_HOST}:${INFLUXDB_PORT}
INFLUXDB_ORG=khalij-holding
INFLUXDB_BUCKET=process_sensors
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=change_me_strong_password
INFLUXDB_TOKEN=change_me_super_secret_admin_token
# داده خام ثانیه‌ای (hot) — ۳۰ روز؛ داده downsampled دقیقه‌ای (cold) — ۵ سال
INFLUXDB_HOT_RETENTION=30d
INFLUXDB_RETENTION=1825d
INFLUXDB_BUCKET_DOWNSAMPLED=process_sensors_1m

# ---------- Redis (کش) ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

# ---------- Kafka (استریمینگ) ----------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_RAW_SENSORS=raw-sensor-data
KAFKA_TOPIC_PROCESSED_SENSORS=processed-sensor-data
KAFKA_TOPIC_PREDICTIONS=process-predictions
KAFKA_TOPIC_ALERTS=process-alerts
# Dead Letter Queue برای پیام‌های نامعتبر (فاز ۲)
KAFKA_TOPIC_RAW_DLQ=raw-sensor-data-dlq
KAFKA_TOPIC_PROCESSED_DLQ=processed-sensor-data-dlq
KAFKA_CONSUMER_GROUP=khalij-pos

# ---------- MLflow ----------
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_BACKEND_STORE_URI=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/mlflow
MLFLOW_ARTIFACT_ROOT=/mlartifacts

# ---------- Prediction / Optimization ----------
PREDICTION_HORIZON_SECONDS=60
CRITICAL_DEVIATION_PERCENT=5
REACTOR_NOMINAL_TEMP_C=250

# ---------- Alerting ----------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=alerts@khalij.com
SMTP_PASSWORD=change_me
SMTP_FROM_ADDRESS=alerts@khalij.com
SMTP_TO_ADDRESSES=control-room@khalij.com

# ---------- Security ----------
JWT_SECRET_KEY=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
TWO_FACTOR_REQUIRED=true
# کلید ۳۲ بایتی AES-256 به‌صورت Base64 (NFR-SEC-02) — تولید با:
#   python -c "from shared.crypto import generate_key_b64; print(generate_key_b64())"
DATA_ENCRYPTION_KEY=

# فاز ۶ — سخت‌سازی امنیت
# در production حتماً CORS را محدود کنید (مثلاً https://pos.khalij.local)
CORS_ALLOW_ORIGINS=*
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=120
# در production=true و کلیدهای ضعیف → سرویس بالا نمی‌آید
ENFORCE_PRODUCTION_SECRETS=false
# کلید مشترک Gateway → میکروسرویس‌های داخلی (خالی = غیرفعال در توسعه)
INTERNAL_API_KEY=
ENVIRONMENT=development

# ---------- Service Ports ----------
API_GATEWAY_PORT=8000
DATA_INGESTION_PORT=8001
PREPROCESSING_PORT=8002
PREDICTION_PORT=8003
ALERTING_PORT=8004

# ---------- Data Ingestion / Hardware (فاز ۱) ----------
# simulator | opcua | modbus
DATA_SOURCE_MODE=simulator
DATA_UNIT_ID=1
# فاز ۷: لیست/بازه واحدها برای مقیاس افقی (مثال: 1-100 یا 1,2,5-10)
DATA_UNIT_IDS=1
INGESTION_SHARD_COUNT=1
INGESTION_SHARD_ID=0
INGESTION_INTERVAL_S=1.0
INFLUX_BATCH_SIZE=50
BACKPRESSURE_HIGH=1000
BACKPRESSURE_LOW=200
# تعداد پارتیشن Kafka برای topicهای اصلی (نیاز به recreate topic در صورت تغییر)
KAFKA_PARTITIONS=12
KAFKA_LINGER_MS=20
KAFKA_COMPRESSION=lz4
PREDICTION_LATENCY_BUDGET_MS=2000

# ---------- Pilot / فاز ۱۰ ----------
# docker compose -f docker-compose.yml -f docker-compose.pilot.yml up -d
PILOT_DATA_SOURCE_MODE=simulator
PILOT_CORS_ORIGINS=http://localhost:8000,https://localhost
PILOT_ENFORCE_SECRETS=false

# ---------- Observability / فاز ۸ ----------
LOG_FORMAT=json
# خالی = tracing خاموش؛ با profile observability: http://tempo:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_URL=http://localhost:3000
PROMETHEUS_URL=http://localhost:9090

# آدرس سرور OPC-UA (برای تست Docker: opcua-test-server؛ برای DCS واقعی: آدرس واقعی)
OPCUA_ENDPOINT_URL=opc.tcp://opcua-test-server:4840/khalij/olefin1/
# آدرس سرور Modbus TCP (برای تست Docker: modbus-test-server؛ برای PLC واقعی: آدرس واقعی)
MODBUS_HOST=modbus-test-server
MODBUS_PORT=5020
# Circuit Breaker: پس از N خطای متوالی، برای مدت recovery به شبیه‌ساز Fallback می‌شود
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_S=30
HARDWARE_READ_TIMEOUT_S=3

# ---------- MLOps / Phase 3 ----------
RETRAIN_EVERY_N_RECORDS=300
DRIFT_CHECK_EVERY_N=100
DRIFT_PSI_THRESHOLD=0.25
# اختیاری: برای فعال‌سازی LSTM واقعی → pip install tensorflow و PREDICTION_ENABLE_LSTM=true
PREDICTION_ENABLE_LSTM=false
